# Builds the reference mTLS PEP (cmd/connect-proxy) for test/smoke.sh and
# agent-sandbox demos. Build with context=. (repo root).

FROM --platform=$BUILDPLATFORM golang:1.26.5 AS builder

ARG TARGETARCH

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ ./cmd/
COPY pkg/ ./pkg/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build \
    -ldflags="-s -w" \
    -o /connect-proxy ./cmd/connect-proxy

FROM gcr.io/distroless/static-debian13:nonroot

COPY --from=builder /connect-proxy /connect-proxy

ENTRYPOINT ["/connect-proxy"]
