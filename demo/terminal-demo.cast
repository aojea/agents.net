{"version": 2, "width": 80, "height": 24, "timestamp": 1785056307, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/bash", "TERM": "dumb"}}
[0.009466, "o", "\r\n# 1. Start host-side agents.net proxy & ingress gateway\r\n"]
[0.310925, "o", "$ python3 demo/host_proxy.py &\r\n"]
[1.614129, "o", "\r\n# 2. Verify Egress & Trust Contract inside container with --network none\r\n"]
[1.915787, "o", "$ docker run --rm --network none \\\r\n"]
[2.217235, "o", "    -v /tmp/agent-sockets:/var/run/agents.net \\\r\n    -v \"$(pwd)/demo/certs/agent-ca.pem:/var/run/agent-ca.pem:ro\" \\\r\n    -e AGENT_NET_LEGACY_COMPAT=1 \\\r\n    agentsnet-demo curl -s https://example.com\r\n"]
[2.80022, "o", "2026/07/26 08:58:30 socat[12] E write(5, 0x562e993e3000, 24): Broken pipe\r\nCongratulations -- you escaped the zero-network sandbox.\r\nThis response was served locally by the agents.net host proxy over a\r\nreal TLS connection, trusted only because AGENT_CA_CERT (the Trust\r\nContract) was mounted into the sandbox and wired into your runtime's\r\ntrust store. No direct network interface was used to get here.\r\n"]
[3.874851, "o", "\r\n# 3. Verify Ingress Gateway Contract (Send webhook from host to zero-network agent)\r\n"]
[4.176422, "o", "$ curl -X POST -d \"hello from outside world!\" http://localhost:9000/webhook\r\n"]
[5.983622, "o", "Webhook processed securely\r\n"]
[11.102835, "o", "\r\n# 4. Verify host-side proxy audit log (Egress + Ingress events)\r\n"]
[11.404491, "o", "$ cat /tmp/agent-proxy-audit.log\r\n"]
[11.707121, "o", "2026-07-26T08:58:30.407211+00:00 ALLOW-FAKE CONNECT example.com:443\r\n2026-07-26T08:58:32.649636+00:00 ALLOW-FAKE GET http://example.com\r\n2026-07-26T08:58:33.593906+00:00 INGRESS POST /webhook\r\n"]
